# Yahoo Fantasy Sports API Credentials
# Copy this file to .env and fill in your real credentials

# Required: Your Yahoo App Consumer Key and Secret
# Get these from: https://developer.yahoo.com/apps/
YAHOO_CONSUMER_KEY=your_consumer_key_here
YAHOO_CONSUMER_SECRET=your_consumer_secret_here

# Optional: OAuth 2.0 tokens (if you have them)
# These are obtained through the OAuth flow
YAHOO_ACCESS_TOKEN=your_access_token_here
YAHOO_REFRESH_TOKEN=your_refresh_token_here

# Optional: Test configuration
# Set to 'true' to run integration tests with real API calls
RUN_INTEGRATION_TESTS=false

# Optional: Specific test league/game keys for testing
TEST_GAME_KEY=423
TEST_LEAGUE_KEY=423.l.12345
TEST_PLAYER_KEY=423.p.12345
TEST_TEAM_KEY=423.l.12345.t.1