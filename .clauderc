{
  "projectContext": {
    "name": "Yahoo Fantasy Sports API",
    "description": "NodeJS wrapper for the Yahoo! Fantasy Sports API designed to simplify data extraction and interaction with fantasy sports leagues across NFL, MLB, NHL, and NBA",
    "type": "npm-package",
    "version": "6.x",
    "architecture": {
      "pattern": "resource-collection",
      "structure": "ES6 modules with OAuth2 authentication flow",
      "mainFile": "YahooFantasy.mjs",
      "coreComponents": [
        "resources/ - Individual API endpoint wrappers (Game, League, Player, Roster, Team, Transaction, User)",
        "collections/ - Bulk operations for multiple resources (Games, Leagues, Players, Teams, Transactions)",
        "helpers/ - Data parsing and transformation utilities"
      ]
    },
    "techStack": {
      "runtime": "Node.js",
      "modules": "ES6 (ESM)",
      "authentication": "OAuth2.0 (Yahoo API)",
      "dependencies": ["oauth-signature", "https", "crypto", "querystring"],
      "apiVersion": "Yahoo Fantasy Sports API v2"
    },
    "coreFeatures": [
      "OAuth2 authentication flow with automatic token refresh",
      "Resource-based API access (individual entities)",
      "Collection-based API access (bulk operations)",
      "Support for all major fantasy sports (NFL, MLB, NHL, NBA)",
      "Promise-based and callback-based interfaces",
      "Public league data access without authentication",
      "Rate limiting awareness and error handling"
    ]
  },
  "developmentRules": [
    "Follow ES6 module syntax (.mjs extension)",
    "Maintain resource/collection architectural pattern",
    "Use error-first callback convention for consistency",
    "Support both Promise and callback patterns for all methods",
    "Handle Yahoo API rate limiting gracefully",
    "Preserve OAuth2 token refresh functionality",
    "Follow Yahoo API naming conventions for endpoints",
    "Include comprehensive error handling for API failures",
    "Support week/date parameters for time-based queries",
    "Maintain backwards compatibility when adding features"
  ],
  "codeConventions": {
    "fileNaming": "PascalCase for main classes, camelCase for utilities",
    "imports": "Named imports from index.mjs files",
    "exports": "Default export for main classes, named exports for utilities",
    "errorHandling": "Return errors via callback first parameter or Promise rejection",
    "apiMethods": "Resource methods return single entities, Collection methods return arrays",
    "parameterStyle": "Accept both callbacks and return Promises for async operations"
  },
  "yahooApiSpecifics": {
    "baseUrl": "https://fantasysports.yahooapis.com/fantasy/v2",
    "authFlow": "OAuth2 with consumer key/secret + access/refresh tokens",
    "gameKeys": {
      "NFL": "Current season format (e.g., 426 for 2023)",
      "MLB": "Season-specific keys",
      "NHL": "Season-specific keys", 
      "NBA": "Season-specific keys"
    },
    "keyFormats": {
      "league": "{game_key}.l.{league_id}",
      "team": "{game_key}.l.{league_id}.t.{team_id}",
      "player": "{game_key}.p.{player_id}",
      "transaction": "{game_key}.l.{league_id}.tr.{transaction_id}"
    },
    "commonSubresources": ["stats", "roster", "players", "teams", "standings", "scoreboard", "transactions"],
    "rateLimiting": "Yahoo enforces rate limits per app - implement retry logic with exponential backoff"
  },
  "workflowRules": [
    "Test OAuth flow in sandbox environment before production",
    "Validate API responses structure before parsing",
    "Include unit tests for all new resource methods",
    "Document any changes to Yahoo API endpoint mappings",
    "Handle token expiration gracefully in all methods",
    "Support both public and authenticated data access patterns",
    "Maintain helper functions for data normalization across sports",
    "Include examples for common use cases in documentation"
  ],
  "testingGuidelines": [
    "Mock Yahoo API responses for unit tests",
    "Test both authenticated and public API access",
    "Validate error handling for expired tokens",
    "Test rate limiting scenarios",
    "Verify data parsing for all supported sports",
    "Include integration tests with sandbox Yahoo accounts"
  ],
  "commonUseCases": [
    "League management and roster tracking",
    "Player statistics analysis across seasons/weeks",
    "Transaction monitoring and league activity",
    "Automated lineup optimization",
    "Fantasy sports data analysis and reporting",
    "League scoring and standings calculations"
  ],
  "knownLimitations": [
    "Not all Yahoo API subresources are implemented",
    "Rate limiting can cause temporary request blocks", 
    "Token refresh requires proper error handling",
    "Some older league data may have different formats",
    "Public vs authenticated access has different capabilities"
  ],
  "includePaths": [
    "claude-tasks/templates/",
    "claude-tasks/docs/",
    "claude-tasks/tasks/",
    "resources/",
    "collections/",
    "helpers/",
    "tests/",
    "examples/"
  ],
  "taskCategories": {
    "authentication": "OAuth flow improvements, token management, error handling",
    "resources": "Individual API endpoint wrappers (games, leagues, players, teams, etc.)",
    "collections": "Bulk operations and multi-resource queries",
    "helpers": "Data parsing, normalization, and utility functions",
    "testing": "Unit tests, integration tests, mock data",
    "documentation": "API documentation, examples, usage guides",
    "errorHandling": "Rate limiting, API errors, network failures",
    "performance": "Caching, request optimization, batch operations"
  },
  "priorityAreas": [
    "Improve error handling for rate limiting and API failures",
    "Add missing Yahoo API subresources and collections",
    "Enhance data normalization across different sports",
    "Expand test coverage for edge cases",
    "Improve documentation with real-world examples",
    "Optimize for common fantasy sports use cases"
  ]
}
